{
  "expo": {
    "name": "APUNTOR",
    "slug": "apuntor",
    "scheme": "apuntor",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.apuntor.app",
      "infoPlist": {
        "NSCameraUsageDescription": "APUNTOR usa la cámara para escanear tus apuntes en papel.",
        "NSPhotoLibraryUsageDescription": "APUNTOR necesita tus fotos para que puedas subir tus apuntes."
      }
    },
    "android": {
      "package": "pe.apuntor.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "APUNTOR necesita tus fotos para que puedas subir tus apuntes.",
          "cameraPermission": "APUNTOR usa la cámara para escanear tus apuntes en papel.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
