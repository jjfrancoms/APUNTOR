{
  // Publica la versión web (`expo export`) como archivos estáticos en Cloudflare Workers.
  // Las rutas de la app se resuelven en el navegador: cualquier ruta sirve index.html.
  "name": "apuntor",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
