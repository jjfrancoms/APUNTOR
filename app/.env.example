# Configuración pública de la app (Expo la incrusta al compilar: nada secreto aquí).
# Copia este archivo como app/.env y completa los valores.

# Supabase › Project Settings › API: URL del proyecto y clave publicable (anon/publishable).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# API de APUNTOR. Con Expo Go, usa la IP de tu laptop en la red Wi-Fi (no localhost),
# por ejemplo http://192.168.1.20:3001
EXPO_PUBLIC_API_URL=http://192.168.1.20:3001

# Inicio con Google (Supabase OAuth). Déjalo en 0 hasta activar el proveedor Google en
# Supabase › Authentication › Providers; con 1 aparece "Continuar con Google".
EXPO_PUBLIC_GOOGLE_AUTH=0
