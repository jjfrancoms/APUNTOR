# Supabase Postgres. Pooler en modo transacción para las consultas de la API y el worker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apuntor
# Conexión directa o de sesión para la cola pg-boss (no sirve el modo transacción).
QUEUE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apuntor

# Supabase Auth: la API verifica los JWT con las claves públicas del proyecto (JWKS).
SUPABASE_URL=https://your-project.supabase.co
# Solo servidor: permite borrar cuentas. Nunca la pongas en app/.env.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (solo servidor)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=apuntor-documents

# IA, opción 1 (gratis, para pruebas): clave de la API de Gemini de Google AI Studio
# (https://aistudio.google.com/apikey). Si está, se usa en lugar de Vertex AI.
# Su plan gratis puede usar el contenido para mejorar los productos de Google: no la uses
# con apuntes de estudiantes reales.
GEMINI_API_KEY=
# Modelo base de generación. Vacío = gemini-2.5-flash. Las cuentas nuevas de la API de Gemini
# ya no tienen acceso a ese modelo: usa gemini-3.8-flash.
GENERATION_MODEL=
# Dos modelos según la tarea (vacíos = el de generación):
# - MODEL_FAST, el rápido: lo que el estudiante espera en el momento (respuestas del chat).
#   En el plan gratis, gemini-flash-lite-latest (responde en ~2 s).
# - MODEL_STRONG, el fuerte: trabajo que se hace una vez y se guarda (OCR, resúmenes de tema,
#   generados de antemano por el worker). Más lento pero más preciso (fórmulas, tablas). También
#   da un segundo intento al chat cuando la respuesta rápida no pasa el validador de citas.
#   En el plan gratis, gemini-3.8-flash.
MODEL_FAST=
MODEL_STRONG=
# Ajustes más específicos (opcionales): modelo del chat (vacío = el rápido) y de los resúmenes
# de tema (vacío = el fuerte).
CHAT_MODEL=
SUMMARY_MODEL=

# IA, opción 2 (producción): Vertex AI. La autenticación usa las credenciales por defecto de Google
# (GOOGLE_APPLICATION_CREDENTIALS). Confirma que los modelos existan en la región elegida.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Tavily (opcional): sin clave, el contexto externo queda desactivado.
TAVILY_API_KEY=

# API
PORT=3001
# Correos con acceso al panel de administrador (/v1/admin/*), separados por comas.
# Vacío = nadie es administrador. Solo metadatos y conteos: nunca contenido de documentos.
ADMIN_EMAILS=
# Orígenes web permitidos, separados por comas.
CORS_ORIGINS=http://localhost:8081
