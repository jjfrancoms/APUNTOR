# Postgres (Supabase). Usa el pooler en modo transacción para la app y el worker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apuntor

# Supabase (solo servidor: la service role key NUNCA se expone al cliente)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Redis para la cola de ingestión (BullMQ)
REDIS_URL=redis://localhost:6379

# Proveedor de LLM / embeddings
LLM_API_KEY=
