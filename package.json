{
  "name": "apuntor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "scripts": {
    "dev": "tsx watch api/src/index.ts",
    "worker": "tsx worker/src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verificar": "npm run typecheck && npx tsc -p e2e/tsconfig.json && npm run lint && npm test && npm --prefix app run typecheck && npm --prefix app test && npm run test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "api": "tsx api/src/index.ts",
    "eval": "tsx eval/cli.ts",
    "legal:html": "tsx app/scripts/build-legal-pages.ts",
    "reprocess": "tsx worker/src/reprocess.ts",
    "app": "npm --prefix app start",
    "start": "tsx api/src/index.ts",
    "start:worker": "tsx worker/src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@google/genai": "^2.32.0",
    "@napi-rs/canvas": "1.0.13",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pg-boss": "^12.38.0",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "^0.0.16",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
